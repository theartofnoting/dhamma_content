# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET: Optional GitHub OAuth App credentials
# for popup login on the Express server (https://github.com/settings/developers).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GITHUB_OWNER: GitHub username allowed to unlock editing (defaults to theartofnoting).
GITHUB_OWNER="theartofnoting"

# SESSION_SECRET: Secret used to sign HTTP-only session cookies on the Express server.
SESSION_SECRET=""
